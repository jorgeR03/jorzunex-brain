# Copia este archivo a .env y rellena los valores. .env NUNCA se commitea
# (ver .gitignore raíz del repo).
#
# --- Autenticación con Claude -------------------------------------------
# El Claude Agent SDK resuelve las credenciales automáticamente en este orden:
#   1. ANTHROPIC_API_KEY (esta variable, si está definida)
#   2. Login de Claude Code ya hecho en esta máquina (`claude /login` /
#      `ant auth login`) — no requiere ninguna variable aquí.
# Para desarrollo local con la suscripción de Jorge, deja esta variable vacía
# y usa el login de Claude Code. Rellénala solo si vas a facturar contra la
# API directamente (runtime del gateway en producción, ver ADR-0001 §3).
ANTHROPIC_API_KEY=

# --- Persistencia ---------------------------------------------------------
# postgres | jsonl | auto (por defecto "auto": prueba Postgres, si falla usa JSONL)
BRAIN_STORAGE_BACKEND=auto

# Conexión a Postgres (debe coincidir con infra/docker-compose.yml).
# Alternativa: define DATABASE_URL directamente y se usa tal cual.
POSTGRES_USER=brain
POSTGRES_PASSWORD=brain_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=jorzunex_brain
# DATABASE_URL=postgresql://brain:brain_dev_password@localhost:5432/jorzunex_brain

# Ruta del archivo JSONL de fallback (por defecto: gateway/data/conversations.jsonl)
# BRAIN_JSONL_PATH=./data/conversations.jsonl

# --- Observabilidad (Langfuse, F2) -----------------------------------------
# Opcional: si dejas estas dos vacías, la integración queda desactivada
# silenciosamente (no rompe nada). Levanta Langfuse con `docker compose up -d`
# en infra/ y crea el par de claves ahí (UI en http://localhost:3000, o
# usa LANGFUSE_INIT_* en infra/.env para auto-provisionar sin pasar por la UI
# — ver infra/README.md).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3000

# --- Voz de alta calidad (ElevenLabs, ADR-0002 escalón C) ------------------
# Opcional: si dejas alguna de las dos vacía, el canal web cae automáticamente
# a la voz del navegador (gratis pero menos natural) — no rompe nada.
# 1. Crea una API key en elevenlabs.io → Settings → API Keys, con permisos
#    "text_to_speech" como mínimo (idealmente también "voices_read").
# 2. El voice_id DEBE ser de TU cuenta ("My Voices"), no de la librería
#    compartida — el plan gratuito bloquea voces de librería vía API
#    (verificado: 402 "Free users cannot use library voices via the API").
#    Cópialo desde elevenlabs.io → My Voices → "..." → Copy Voice ID.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
